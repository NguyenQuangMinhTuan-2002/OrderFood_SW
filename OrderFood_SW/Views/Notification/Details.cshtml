@model OrderFood_SW.Models.Notification
@{
    ViewData["Title"] = "Chi tiết thông báo";
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">
            <i class="fa fa-eye"></i> Chi tiết thông báo
        </h3>
    </div>
    <div class="box-body">
        <div class="row">
            <div class="col-md-12">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 150px;">Tiêu đề:</th>
                        <td><strong>@Model.Title</strong></td>
                    </tr>
                    <tr>
                        <th>Người gửi:</th>
                        <td>@Model.SenderName</td>
                    </tr>
                    <tr>
                        <th>Loại:</th>
                        <td>
                            <span class="label label-@(Model.Type == "Warning" ? "warning" : Model.Type == "Error" ? "danger" : "info")">
                                @Model.Type
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Độ ưu tiên:</th>
                        <td>
                            <span class="label label-@(Model.Priority == "Urgent" ? "danger" : Model.Priority == "High" ? "warning" : "default")">
                                @Model.Priority
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Ngày tạo:</th>
                        <td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                    @if (Model.UpdatedDate.HasValue)
                    {
                        <tr>
                            <th>Ngày cập nhật:</th>
                            <td>@Model.UpdatedDate.Value.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                    <tr>
                        <th>Trạng thái:</th>
                        <td>
                            @if (Model.IsRead)
                            {
                                <span class="label label-success">Đã đọc</span>
                            }
                            else
                            {
                                <span class="label label-warning">Chưa đọc</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Nội dung:</th>
                        <td>
                            <div style="white-space: pre-wrap; background-color: #f9f9f9; padding: 10px; border-radius: 4px;">
                                @Model.Content
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="form-group">
            <a href="~/Notification/Index" class="btn btn-default">
                <i class="fa fa-arrow-left"></i> Quay lại
            </a>
            @if (ViewBag.Role == "Staff")
            {
                <a href="~/Notification/Edit/@Model.Id" class="btn btn-warning">
                    <i class="fa fa-edit"></i> Chỉnh sửa
                </a>
                <a href="~/Notification/Delete/@Model.Id" class="btn btn-danger">
                    <i class="fa fa-trash"></i> Xóa
                </a>
            }
        </div>
    </div>
</div>
