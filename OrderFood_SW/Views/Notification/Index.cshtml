@model IEnumerable<OrderFood_SW.Models.Notification>
@inject OrderFood_SW.Services.NotificationService NotificationService
@{
    ViewData["Title"] = "Notification";
    var role = ViewBag.Role as string;
    var userId = ViewBag.UserId as int?;
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">
            <i class="fa fa-bell"></i> Notification management
        </h3>
        @if (role == "Staff")
        {
            <div class="box-tools pull-right">
                <a href="~/Notification/Create" class="btn btn-primary">
                    <i class="fa fa-plus"></i> Create new notification
                </a>
            </div>
        }
    </div>
    <div class="box-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible">
                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                <h4><i class="icon fa fa-check"></i> success!</h4>
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible">
                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                <h4><i class="icon fa fa-ban"></i> error!</h4>
                @TempData["ErrorMessage"]
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead>
                        <tr class="bg-primary">
                            <th>Title</th>
                            <th>Sender</th>
                            <th>Type</th>
                            <th>Priority</th>
                            <th>Create Date</th>
                            <th>Status</th>
                            <th style="width:120px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var notification in Model)
                        {
                            var isRead = userId.HasValue ? NotificationService.IsNotificationReadByUser(notification.Id, userId.Value) : false;
                            <tr class="@(isRead ? "" : "bg-warning")">
                                <td>
                                    <strong>@notification.Title</strong>
                                    @if (!isRead)
                                    {
                                        <span class="label label-danger">New</span>
                                    }
                                </td>
                                <td>@notification.SenderName</td>
                                <td>
                                    <span class="label label-@(notification.Type == "Warning" ? "warning" : notification.Type == "Error" ? "danger" : "info")">
                                        @notification.Type
                                    </span>
                                </td>
                                <td>
                                    <span class="label label-@(notification.Priority == "Urgent" ? "danger" : notification.Priority == "High" ? "warning" : "default")">
                                        @notification.Priority
                                    </span>
                                </td>
                                <td>@notification.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (isRead)
                                    {
                                        <span class="label label-success">Read</span>
                                    }
                                    else
                                    {
                                        <span class="label label-warning">Unread</span>
                                    }
                                </td>
                                <td>
                                    <a href="~/Notification/Details/@notification.Id"
                                       class="btn btn-xs btn-info" title="Xem chi tiết">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    @if (role == "Staff")
                                    {
                                        <a href="~/Notification/Edit/@notification.Id" class="btn btn-xs btn-warning" title="Chỉnh sửa">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a href="~/Notification/Delete/@notification.Id" class="btn btn-xs btn-danger" title="Xóa">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="container" style="margin-top: auto; padding-bottom: 20px;">
                    <div class="text-center">
                        <ul class="pagination">
                            <!-- First Page -->
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li>
                                    <a href="@Url.Action("Index", new { page = 1 })">First</a>
                                </li>
                            }
                            else
                            {
                                <li class="disabled"><a href="#">First</a></li>
                            }

                            <!-- Page Numbers -->
                            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                            {
                                if (i == ViewBag.CurrentPage)
                                {
                                    <li class="active"><a href="#">@i</a></li>
                                }
                                else
                                {
                                    <li><a href="@Url.Action("Index", new { page = i })">@i</a></li>
                                }
                            }

                            <!-- Last Page -->
                            @if (ViewBag.CurrentPage < (int)ViewBag.TotalPages)
                            {
                                <li>
                                    <a href="@Url.Action("Index", new { page = ViewBag.TotalPages })">Last</a>
                                </li>
                            }
                            else
                            {
                                <li class="disabled"><a href="#">Last</a></li>
                            }
                        </ul>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">
                <h4><i class="icon fa fa-info"></i> Notification!</h4>
                No announcement yet.
            </div>
        }
    </div>
</div>

<!-- Auto refresh disabled to prevent badge conflicts -->
