@model OrderFood_SW.Models.Notification
@{
    ViewData["Title"] = "Xóa thông báo";
}

<div class="box box-danger">
    <div class="box-header with-border">
        <h3 class="box-title">
            <i class="fa fa-trash"></i> Xác nhận xóa thông báo
        </h3>
    </div>
    <div class="box-body">
        <div class="alert alert-warning">
            <h4><i class="icon fa fa-warning"></i> Cảnh báo!</h4>
            Bạn có chắc chắn muốn xóa thông báo này không? Hành động này không thể hoàn tác.
        </div>

        <div class="row">
            <div class="col-md-12">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 150px;">Tiêu đề:</th>
                        <td><strong>@Model.Title</strong></td>
                    </tr>
                    <tr>
                        <th>Người gửi:</th>
                        <td>@Model.SenderName</td>
                    </tr>
                    <tr>
                        <th>Loại:</th>
                        <td>
                            <span class="label label-@(Model.Type == "Warning" ? "warning" : Model.Type == "Error" ? "danger" : "info")">
                                @Model.Type
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Độ ưu tiên:</th>
                        <td>
                            <span class="label label-@(Model.Priority == "Urgent" ? "danger" : Model.Priority == "High" ? "warning" : "default")">
                                @Model.Priority
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Ngày tạo:</th>
                        <td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                    <tr>
                        <th>Nội dung:</th>
                        <td>@Model.Content</td>
                    </tr>
                </table>
            </div>
        </div>

        <form asp-action="DeleteConfirmed" method="post">
            <input asp-for="Id" type="hidden" />
            <div class="form-group">
                <button type="submit" class="btn btn-danger">
                    <i class="fa fa-trash"></i> Xác nhận xóa
                </button>
                <a href="~/Notification/Index" class="btn btn-default">
                    <i class="fa fa-arrow-left"></i> Quay lại
                </a>
            </div>
        </form>
    </div>
</div>
