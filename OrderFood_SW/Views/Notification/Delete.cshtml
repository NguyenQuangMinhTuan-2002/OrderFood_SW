@model OrderFood_SW.Models.Notification
@{
    ViewData["Title"] = "Delete notification";
}

<div class="box box-danger">
    <div class="box-header with-border">
        <h3 class="box-title">
            <i class="fa fa-trash"></i> Confirm delete notification
        </h3>
    </div>
    <div class="box-body">
        <div class="alert alert-warning">
            <h4><i class="icon fa fa-warning"></i> Warning!</h4>
            Are you sure you want to delete this notification? This action cannot be undone.
        </div>

        <div class="row">
            <div class="col-md-12">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 150px;">Title:</th>
                        <td><strong>@Model.Title</strong></td>
                    </tr>
                    <tr>
                        <th>Sender:</th>
                        <td>@Model.SenderName</td>
                    </tr>
                    <tr>
                        <th>Type:</th>
                        <td>
                            <span class="label label-@(Model.Type == "Warning" ? "warning" : Model.Type == "Error" ? "danger" : "info")">
                                @Model.Type
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Priority:</th>
                        <td>
                            <span class="label label-@(Model.Priority == "Urgent" ? "danger" : Model.Priority == "High" ? "warning" : "default")">
                                @Model.Priority
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Create Date:</th>
                        <td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                    <tr>
                        <th>Content:</th>
                        <td>@Model.Content</td>
                    </tr>
                </table>
            </div>
        </div>

        <form asp-action="DeleteConfirmed" method="post">
            <input asp-for="Id" type="hidden" />
            <div class="form-group">
                <button type="submit" class="btn btn-danger">
                    <i class="fa fa-trash"></i> Confirm
                </button>
                <a href="~/Notification/Index" class="btn btn-default">
                    <i class="fa fa-arrow-left"></i> Back
                </a>
            </div>
        </form>
    </div>
</div>
