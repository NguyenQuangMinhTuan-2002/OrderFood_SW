@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var fullName = HttpContextAccessor.HttpContext.Session.GetString("FullName");
    var role = HttpContextAccessor.HttpContext.Session.GetString("Role");
    var UserId = HttpContextAccessor.HttpContext.Session.GetString("UserId");
    var imageAvatar = HttpContextAccessor.HttpContext.Session.GetString("ImageAvat");
}

<aside class="main-sidebar" style="padding-top:0px">
    <!-- sidebar: style can be found in sidebar.less -->
    <section class="sidebar">
        <!-- Sidebar user panel -->
        <div class="user-panel">
            <div class="pull-left image">
                <!-- ~/themes/dist/img/user2-160x160.jpg -->
                <img src="~/images/Users/@imageAvatar" class="img-circle" alt="User Image">
            </div>
            <div class="pull-left info">
                <p>
                    @if (!string.IsNullOrEmpty(fullName))
                    {
                        <span>@fullName</span>
                    }
                </p>
                <a href="#"><i class="fa fa-circle text-success"></i> Online</a>
            </div>
        </div>
        <!-- sidebar menu: : style can be found in sidebar.less -->
        <ul class="sidebar-menu" data-widget="tree">
            <li class="header">MAIN NAVIGATION</li>
            <li class="treeview">
                <a href="#">
                    <i class="fa fa-file-o"></i> <span>Managements</span>
                    <span class="pull-right-container">
                        <i class="fa fa-angle-left pull-right"></i>
                    </span>
                </a>
                <ul class="treeview-menu">
                    <li><a href="~/Tables"><i class="fa fa-circle-o"></i> Tables</a></li>
                    <li><a href="~/Categories"><i class="fa fa-circle-o"></i> Categories</a></li>
                    <li><a href="~/Dishes"><i class="fa fa-circle-o"></i> Dishes</a></li>
                    <li><a href="~/Users"><i class="fa fa-circle-o"></i> Account</a></li>
                    <li><a href="~/TaxRate"><i class="fa fa-circle-o"></i> Tax Rate</a></li>
                </ul>
            </li>

            <li class="treeview">
                <a href="#">
                    <i class="fa fa-cart-arrow-down"></i> <span>Order</span>
                    <span class="pull-right-container">
                        <i class="fa fa-angle-left pull-right"></i>
                    </span>
                </a>
                <ul class="treeview-menu">
                    <li><a href="~/Order"><i class="fa fa-circle-o"></i> Create New Order</a></li>
                    <li><a href="~/Order/OrderList"><i class="fa fa-circle-o"></i> List Of Order</a></li>
                    <li><a href="~/Order/OrderHistory"><i class="fa fa-circle-o"></i> History</a></li>
                </ul>
            </li>

            <li class="treeview">
                <a href="#">
                    <i class="fa fa-dashboard"></i> <span>Statistic</span>
                    <span class="pull-right-container">
                        <i class="fa fa-angle-left pull-right"></i>
                    </span>
                </a>
                <ul class="treeview-menu">
                    <li><a href="~/Statistic/Revenue"><i class="fa fa-circle-o"></i> Revenue</a></li>
                    <li><a href="~/Statistic/Order"><i class="fa fa-circle-o"></i> Order</a></li>
                    @* <li><a href="~/Dishes"><i class="fa fa-circle-o"></i> Employee</a></li> *@
                </ul>
            </li>

            <li class="treeview">
                <a href="#">
                    <i class="fa fa-bell"></i> <span>Notification</span>
                    <span class="pull-right-container">
                        <i class="fa fa-angle-left pull-right"></i>
                    </span>
                </a>
                <ul class="treeview-menu">
                    <li><a href="~/Notification/Index"><i class="fa fa-circle-o"></i> Notification list</a></li>
                    @if (role == "Staff")
                    {
                        <li><a href="~/Notification/Create"><i class="fa fa-circle-o"></i> Create new</a></li>
                    }
                </ul>
            </li>

            <li><a href="~/Home/Documentation"><i class="fa fa-book"></i> <span>Documentation</span></a></li>
            <li class="header">LABELS</li>
            <li><a href="#"><i class="fa fa-circle-o text-yellow"></i> <span>Warning checker</span></a></li>
            <li><a href="~/CustomerOrder/Index"><i class="fa fa-circle-o text-aqua"></i> <span>Customer page review</span></a></li>

        </ul>
    </section>
    <!-- /.sidebar -->
</aside>