@model OrderFood_SW.Models.ErrorViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    Layout = null;
    ViewData["Title"] = "Có lỗi xảy ra";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    
    <link href="~/css/error.css" rel="stylesheet" asp-append-version="true"/>
</head>
<body>
    <div class="error-container">
        <div class="error-header">
            <div class="error-icon">@(Model.IsStatusCodeError ? Model.GetStatusCodeIcon() : "⚠️")</div>
            <h1>@(Model.IsStatusCodeError ? Model.GetStatusCodeTitle() : "Oops! Something went wrong")</h1>
            <p>@(Model.IsStatusCodeError ? Model.GetStatusCodeMessage() : "We encountered an unexpected error while processing your request")</p>
        </div>

        <div class="error-content">
            @if (Model.ShowRequestId)
            {
                <div class="error-details">
                    <h3>@(Model.IsStatusCodeError ? "Request Details" : "Error Details")</h3>
                    
                    <div class="detail-item">
                        <span class="detail-label">Request ID:</span>
                        <div class="detail-value">@Model.RequestId</div>
                    </div>

                    @if (Model.StatusCode > 0)
                    {
                        <div class="detail-item">
                            <span class="detail-label">Status Code:</span>
                            <div class="detail-value">@Model.StatusCode</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="detail-item">
                            <span class="detail-label">@(Model.IsStatusCodeError ? "Description:" : "Error Message:")</span>
                            <div class="detail-value">@Model.Message</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Path))
                    {
                        <div class="detail-item">
                            <span class="detail-label">@(Model.IsStatusCodeError ? "Requested Path:" : "Path:")</span>
                            <div class="detail-value">@Model.Path</div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.StackTrace))
                {
                    <div class="error-details">
                        <h3>Stack Trace</h3>
                        <div class="stacktrace">@Model.StackTrace</div>
                    </div>
                }
            }
            else
            {
                <div class="error-details">
                    <h3>@(Model.IsStatusCodeError ? "What can you do?" : "What happened?")</h3>
                    @if (Model.IsStatusCodeError)
                    {
                        @if (Model.StatusCode == 404)
                        {
                            <p style="color: #666; line-height: 1.6;">
                                • Kiểm tra lại URL bạn đã nhập<br/>
                                • Sử dụng menu điều hướng để tìm trang bạn cần<br/>
                                • Quay lại trang trước đó và thử lại<br/>
                                • Liên hệ với chúng tôi nếu bạn tin rằng đây là lỗi
                            </p>
                        }
                        else if (Model.StatusCode == 403)
                        {
                            <p style="color: #666; line-height: 1.6;">
                                • Đăng nhập với tài khoản có quyền phù hợp<br/>
                                • Liên hệ quản trị viên để được cấp quyền truy cập<br/>
                                • Quay lại trang chính và chọn chức năng khác
                            </p>
                        }
                        else if (Model.StatusCode == 401)
                        {
                            <p style="color: #666; line-height: 1.6;">
                                • Đăng nhập để tiếp tục sử dụng<br/>
                                • Kiểm tra thông tin đăng nhập của bạn<br/>
                                • Liên hệ hỗ trợ nếu không thể đăng nhập
                            </p>
                        }
                        else
                        {
                            <p style="color: #666; line-height: 1.6;">
                                • Thử lại sau vài phút<br/>
                                • Quay lại trang trước đó<br/>
                                • Liên hệ hỗ trợ nếu vấn đề vẫn tiếp tục
                            </p>
                        }
                    }
                    else
                    {
                        <p style="color: #666; line-height: 1.6;">
                            An error occurred while processing your request. Our team has been notified and is working to fix the issue.
                            Please try again later or contact support if the problem persists.
                        </p>
                    }
                </div>
            }

            <div class="action-buttons">
                @if (Model.StatusCode == 401)
                {
                    <a href="/Account/Login" class="btn btn-primary">Đăng nhập</a>
                    <button onclick="history.back()" class="btn btn-secondary">Quay lại</button>
                }
                else if (Model.StatusCode == 403)
                {
                    <a href="/" class="btn btn-primary">Trang chủ</a>
                    <button onclick="history.back()" class="btn btn-secondary">Quay lại</button>
                }
                else
                {
                    <a href="/" class="btn btn-primary">Trang chủ</a>
                    <button onclick="history.back()" class="btn btn-secondary">Quay lại</button>
                }
            </div>
        </div>
    </div>
</body>
</html>