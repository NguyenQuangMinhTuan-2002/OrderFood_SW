@model OrderFood_SW.Models.ErrorViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    Layout = null;
    ViewData["Title"] = "Có lỗi xảy ra";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: beige;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .error-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 800px;
            width: 100%;
            overflow: hidden;
        }

        .error-header {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            padding: 40px;
            text-align: center;
            color: white;
        }

        .error-icon {
            font-size: 80px;
            margin-bottom: 20px;
            animation: shake 0.5s ease-in-out;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }

        .error-header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .error-header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .error-content {
            padding: 40px;
        }

        .error-details {
            background: #f8f9fa;
            border-left: 4px solid #f5576c;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 8px;
        }

        .error-details h3 {
            color: #333;
            margin-bottom: 15px;
            font-size: 1.2em;
        }

        .detail-item {
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid #e0e0e0;
        }

        .detail-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .detail-label {
            font-weight: 600;
            color: #555;
            margin-bottom: 5px;
            display: block;
        }

        .detail-value {
            color: #666;
            word-break: break-all;
            font-family: 'Courier New', monospace;
            background: white;
            padding: 10px;
            border-radius: 4px;
            font-size: 0.9em;
        }

        .stacktrace {
            background: #2d2d2d;
            color: #f8f8f2;
            padding: 20px;
            border-radius: 8px;
            overflow-x: auto;
            font-family: 'Courier New', monospace;
            font-size: 0.85em;
            line-height: 1.6;
            max-height: 300px;
            overflow-y: auto;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 8px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-secondary {
            background: #f8f9fa;
            color: #333;
            border: 2px solid #dee2e6;
        }

        .btn-secondary:hover {
            background: #e9ecef;
            transform: translateY(-2px);
        }

        @@media (max-width: 600px) {
            .error-header h1 {
                font-size: 1.8em;
            }

            .error-icon {
                font-size: 60px;
            }

            .error-content {
                padding: 20px;
            }

            .action-buttons {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="error-header">
            <div class="error-icon">@(Model.IsStatusCodeError ? Model.GetStatusCodeIcon() : "⚠️")</div>
            <h1>@(Model.IsStatusCodeError ? Model.GetStatusCodeTitle() : "Oops! Something went wrong")</h1>
            <p>@(Model.IsStatusCodeError ? Model.GetStatusCodeMessage() : "We encountered an unexpected error while processing your request")</p>
        </div>

        <div class="error-content">
            @if (Model.ShowRequestId)
            {
                <div class="error-details">
                    <h3>@(Model.IsStatusCodeError ? "Request Details" : "Error Details")</h3>
                    
                    <div class="detail-item">
                        <span class="detail-label">Request ID:</span>
                        <div class="detail-value">@Model.RequestId</div>
                    </div>

                    @if (Model.StatusCode > 0)
                    {
                        <div class="detail-item">
                            <span class="detail-label">Status Code:</span>
                            <div class="detail-value">@Model.StatusCode</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="detail-item">
                            <span class="detail-label">@(Model.IsStatusCodeError ? "Description:" : "Error Message:")</span>
                            <div class="detail-value">@Model.Message</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Path))
                    {
                        <div class="detail-item">
                            <span class="detail-label">@(Model.IsStatusCodeError ? "Requested Path:" : "Path:")</span>
                            <div class="detail-value">@Model.Path</div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.StackTrace))
                {
                    <div class="error-details">
                        <h3>Stack Trace</h3>
                        <div class="stacktrace">@Model.StackTrace</div>
                    </div>
                }
            }
            else
            {
                <div class="error-details">
                    <h3>@(Model.IsStatusCodeError ? "What can you do?" : "What happened?")</h3>
                    @if (Model.IsStatusCodeError)
                    {
                        @if (Model.StatusCode == 404)
                        {
                            <p style="color: #666; line-height: 1.6;">
                                • Kiểm tra lại URL bạn đã nhập<br/>
                                • Sử dụng menu điều hướng để tìm trang bạn cần<br/>
                                • Quay lại trang trước đó và thử lại<br/>
                                • Liên hệ với chúng tôi nếu bạn tin rằng đây là lỗi
                            </p>
                        }
                        else if (Model.StatusCode == 403)
                        {
                            <p style="color: #666; line-height: 1.6;">
                                • Đăng nhập với tài khoản có quyền phù hợp<br/>
                                • Liên hệ quản trị viên để được cấp quyền truy cập<br/>
                                • Quay lại trang chính và chọn chức năng khác
                            </p>
                        }
                        else if (Model.StatusCode == 401)
                        {
                            <p style="color: #666; line-height: 1.6;">
                                • Đăng nhập để tiếp tục sử dụng<br/>
                                • Kiểm tra thông tin đăng nhập của bạn<br/>
                                • Liên hệ hỗ trợ nếu không thể đăng nhập
                            </p>
                        }
                        else
                        {
                            <p style="color: #666; line-height: 1.6;">
                                • Thử lại sau vài phút<br/>
                                • Quay lại trang trước đó<br/>
                                • Liên hệ hỗ trợ nếu vấn đề vẫn tiếp tục
                            </p>
                        }
                    }
                    else
                    {
                        <p style="color: #666; line-height: 1.6;">
                            An error occurred while processing your request. Our team has been notified and is working to fix the issue.
                            Please try again later or contact support if the problem persists.
                        </p>
                    }
                </div>
            }

            <div class="action-buttons">
                @if (Model.StatusCode == 401)
                {
                    <a href="/Account/Login" class="btn btn-primary">Đăng nhập</a>
                    <button onclick="history.back()" class="btn btn-secondary">Quay lại</button>
                }
                else if (Model.StatusCode == 403)
                {
                    <a href="/" class="btn btn-primary">Trang chủ</a>
                    <button onclick="history.back()" class="btn btn-secondary">Quay lại</button>
                }
                else
                {
                    <a href="/" class="btn btn-primary">Trang chủ</a>
                    <button onclick="history.back()" class="btn btn-secondary">Quay lại</button>
                }
            </div>
        </div>
    </div>
</body>
</html>