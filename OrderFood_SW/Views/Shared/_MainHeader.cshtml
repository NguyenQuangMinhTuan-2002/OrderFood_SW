@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject OrderFood_SW.Services.OrderService OrderService
@inject OrderFood_SW.Services.NotificationService NotificationService
@{
    var fullName = HttpContextAccessor.HttpContext?.Session?.GetString("FullName");
    var role = HttpContextAccessor.HttpContext?.Session?.GetString("Role");
    var imageAvatar = HttpContextAccessor.HttpContext?.Session?.GetString("ImageAvat");
    var userId = HttpContextAccessor.HttpContext?.Session?.GetInt32("UserId");
    var pendingOrdersCount = OrderService.GetPendingOrdersCount();
    var unreadNotificationCount = userId.HasValue ? NotificationService.GetUnreadNotificationCount(userId.Value) : 0;
    var recentUnreadNotifications = userId.HasValue ? NotificationService.GetUnreadNotifications(userId.Value).Take(3).ToList() : new List<OrderFood_SW.Models.Notification>();
}

<header class="main-header fixed-header">
    <!-- Logo -->
    <a href="~/home/Index" class="logo">
        <!-- mini logo for sidebar mini 50x50 pixels -->
        <span class="logo-mini"><b>B</b>F</span>
        <!-- logo for regular state and mobile devices -->
        <span class="logo-lg"><b>BIGFOOD</b>Restaurant</span>
    </a>
    <!-- Header Navbar: style can be found in header.less -->
    <nav class="navbar navbar-static-top">
        <!-- Sidebar toggle button-->
        <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button">
            <span class="sr-only">Toggle navigation</span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
        </a>

        <div class="navbar-custom-menu">
            <ul class="nav navbar-nav">
                <!-- Notifications: style can be found in dropdown.less -->
                <li class="dropdown notifications-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                        <i class="fa fa-bell-o"></i>
                        <span class="label label-warning">@pendingOrdersCount</span>
                    </a>
                    <ul class="dropdown-menu">
                        <li class="header">You have @pendingOrdersCount notifications</li>
                        <li>
                            <!-- inner menu: contains the actual data -->
                            <ul class="menu">
                                <li>
                                    <a href="~/Order/OrderList">
                                        <i class="fa fa-shopping-cart text-aqua"></i> @pendingOrdersCount order is pending
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="footer"><a href="~/Order/OrderList">View all</a></li>
                    </ul>
                </li>
                
                <!-- System Notifications -->
                <li class="dropdown notifications-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                        <i class="fa fa-envelope-o"></i>
                        <span class="label label-danger">@unreadNotificationCount</span>
                    </a>
                    <ul class="dropdown-menu">
                        <li class="header">You have @unreadNotificationCount unread notifications</li>
                        <li>
                            <!-- inner menu: contains the actual data -->
                            <ul class="menu">
                                @if (recentUnreadNotifications != null && recentUnreadNotifications.Any())
                                {
                                    @foreach (var notification in recentUnreadNotifications)
                                    {
                                        <li>
                                            <a href="~/Notification/Details/@notification.Id">
                                                <i class="fa fa-@(notification.Type == "Warning" ? "warning" : notification.Type == "Error" ? "exclamation-triangle" : "info-circle") text-@(notification.Type == "Warning" ? "yellow" : notification.Type == "Error" ? "red" : "blue")"></i> 
                                                @notification.Title
                                                <span class="label label-danger pull-right">New</span>
                                            </a>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li>
                                        <a href="#">
                                            <i class="fa fa-info-circle text-blue"></i> No announcements yet
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                        <li class="footer"><a href="~/Notification/Index">View all notifications</a></li>
                    </ul>
                </li>
                <!-- User Account: style can be found in dropdown.less -->
                <li class="dropdown user user-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                        <img src="~/images/Users/@imageAvatar" class="user-image" alt="User Image">
                        <span class="hidden-xs">
                            @if (!string.IsNullOrEmpty(fullName))
                            {
                                <text>Hello! @fullName</text>
                            }
                            else
                            {
                                <text>Hello! Guess</text>
                            }
                        </span>

                    </a>
                    <ul class="dropdown-menu">
                        <!-- User image -->
                        <li class="user-header">
                            <img src="~/images/Users/@imageAvatar" class="img-circle" alt="User Image">

                            <p>
                                @if (!string.IsNullOrEmpty(fullName))
                                {
                                    <text>Xin chào, @fullName - @role</text>
                                }
                            </p>
                        </li>
                        <!-- Menu Footer-->
                        <li style="background-color:blanchedalmond" class="user-footer">
                            <div style="display:flex">
                                <a style="width: 50%" href="#" class="btn btn-default btn-flat">Profile</a>
                                <a style="width: 50%" href="~/Account/Logout" class="btn btn-default btn-flat">Sign out</a>
                            </div>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>
</header>

<!-- Auto refresh disabled to prevent badge conflicts -->