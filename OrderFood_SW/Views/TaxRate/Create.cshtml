@model OrderFood_SW.Models.TaxRate
@{
    ViewData["Title"] = "Create";
}

<!-- box border (just decor) -->
<div class="box box-primary" style="min-height:74vh;">
    <div class="box-body">
        <!-- edit form table -->
        <div class="row">
            <div class="col-md-6 col-sm-8 col-md-offset-3 col-sm-offset-2">
                <div class="panel panel-default" style="margin: 50px 0px">
                    <div class="panel-heading" style="text-align: center">
                        <strong>Create New Tax Rate Information</strong>
                    </div>
                    <div class="panel-body">
                        <form asp-action="Create" class="form-horizontal" role="form">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="form-group">
                                <label asp-for="Name" class="col-sm-3 control-label"></label>
                                <div class="col-sm-9">
                                    <input asp-for="Name" class="form-control" placeholder="Enter tax rate name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="Rate" class="col-sm-3 control-label"></label>
                                <div class="col-sm-9">
                                    <div class="input-group">
                                        <input asp-for="Rate" class="form-control" placeholder="0.10" step="0.01" min="0" max="1" />
                                        <span class="input-group-addon">%</span>
                                    </div>
                                    <span asp-validation-for="Rate" class="text-danger"></span>
                                    <small class="help-block">Enter as decimal (e.g., 0.10 for 10%)</small>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="Description" class="col-sm-3 control-label"></label>
                                <div class="col-sm-9">
                                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter description (optional)"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">Check box</label>
                                <div class="col-sm-9">
                                    <label class="form-check-label" style="margin-top:6px">
                                        <input class="form-check-input" asp-for="IsActive" /> Set as active tax rate
                                    </label>
                                    <small class="help-block">Only one tax rate can be active at a time</small>
                                </div>
                            </div>

                            <div class="form-group text-right">
                                <div class="col-sm-offset-3 col-sm-9">
                                    <input type="submit" value="Create New" class="btn btn-success" />
                                    <a asp-action="Index" class="btn btn-default">Back to List</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
