@model List<OrderFood_SW.Models.TaxRate>
@{
    ViewData["Title"] = "Tax Rate Management";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
        <h4><i class="icon fa fa-check"></i> Success!</h4>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
        <h4><i class="icon fa fa-ban"></i> Error!</h4>
        @TempData["Error"]
    </div>
}

<!-- Tax Rate Management -->
<div class="box box-primary">
    <div class="box-body">
        <div class="input-group">
            <div class="input-group-btn">
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="fa fa-plus"></i> Add New Tax Rate
                </a>
            </div>
        </div>
        <br />

        <!-- Tax Rates Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover">
                <thead>
                    <tr class="bg-primary">
                        <th>Name</th>
                        <th>Rate</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th style="width:95px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var taxRate in Model)
                    {
                        <tr>
                            <td>@taxRate.Name</td>
                            <td>@(taxRate.Rate.ToString("P2"))</td>
                            <td>@(taxRate.Description ?? "N/A")</td>
                            <td>
                                @if (taxRate.IsActive)
                                {
                                    <span class="label label-success">Active</span>
                                }
                                else
                                {
                                    <span class="label label-default">Inactive</span>
                                }
                            </td>
                            <td>@taxRate.CreatedDate.ToString("MM/dd/yyyy HH:mm")</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = taxRate.Id })" class="btn btn-xs btn-info">
                                    <i class="fa fa-edit"></i>
                                </a>
                                @if (!taxRate.IsActive)
                                {
                                    <form method="post" action="@Url.Action("SetActive", new { id = taxRate.Id })" style="display: inline;">
                                        <button type="submit" class="btn btn-xs btn-success" onclick="return confirm('Are you sure you want to activate this tax rate?')">
                                            <i class="fa fa-check"></i>
                                        </button>
                                    </form>
                                    <form method="post" action="@Url.Action("Delete", new { id = taxRate.Id })" style="display: inline;">
                                        <button type="submit" class="btn btn-xs btn-danger" onclick="return confirm('Are you sure you want to delete this tax rate?')">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
